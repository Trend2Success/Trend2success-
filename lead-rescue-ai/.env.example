# Supabase project settings. Get these from your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# There is no webhook secret here: each tenant has its own
# webhook_signing_secret, generated by the tenants table's default and used
# to validate the X-Lead-Signature header on that tenant's inbound leads
# webhook (POST /api/webhooks/leads/[tenantId]). See the README's
# "Provisioning a tenant" section.

# Server-only. Used to draft the first-response SMS for a new lead. If unset
# (along with the Twilio variables below), new leads go straight to
# human_review instead of getting an AI-drafted text — the webhook never
# fails just because these aren't configured yet.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Server-only. Used to send the first-response SMS once it passes the
# guardrail filter. All three are required together.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15555550100
