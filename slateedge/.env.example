# Copy this file to .env (for docker compose) and/or slateedge/web/.env
# (for local `npm run dev`). Never commit real secrets.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=slateedge
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=slateedge
# Used by the web app. When running via docker compose, host is the service
# name "db"; when running `npm run dev` against `docker compose up db`, use
# localhost instead.
DATABASE_URL=postgresql://slateedge:change-me-locally@db:5432/slateedge?schema=public

# --- Web app -----------------------------------------------------------------
# Random 32+ byte secret used to sign local session cookies. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=replace-this-with-a-long-random-string

# Base URL the web app uses to call the Python analytics service.
OPTIMIZER_SERVICE_URL=http://optimizer:8000

NODE_ENV=production

# --- Optimizer service ---------------------------------------------------------
# No secrets required — it never talks to any external API or database.
